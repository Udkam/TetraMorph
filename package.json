{
  "name": "tetramorph",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "engines": { "node": ">=24.12.0 <25" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "test:release": "node scripts/release-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/metal": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/playwrite-nz-basic": "5.3.0",
    "pixi.js": "8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "playwright": "1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "4.1.11"
  }
}
